# ==============================================================================
# Shreeji Bawa Blog - Environment Configuration
# ==============================================================================

# Supabase Public Configuration (Accessible in browser & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Configuration (NEVER expose to browser/client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini API (For AI Auto-Translation in Admin CMS)
# Get a free API key at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
